{
  "schema": "agentlab.tablegit.definitions.v1",
  "tables": {
    "difficulty_points": {
      "key_field": "id",
      "description": "Evidence-linked Code Agent difficulty mechanisms.",
      "required_fields": ["id", "schema", "dimensionId", "primaryDimension", "mechanism", "status", "maturityState"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "taskId": {"type": "string", "required": false},
        "dimensionId": {"type": "string", "required": true},
        "primaryDimension": {"type": "string", "required": true},
        "mechanism": {"type": "string", "required": true},
        "signature": {"type": "string", "required": false},
        "status": {"type": "string", "required": true},
        "maturityState": {"type": "string", "required": true},
        "sourceRevision": {"type": "string", "required": false},
        "checkpointIds": {"type": "array", "required": false},
        "evidenceIds": {"type": "array", "required": false},
        "observation": {"type": "object", "required": false}
      },
      "indexes": [
        {"name": "by_dimensionId", "field": "dimensionId"},
        {"name": "by_primaryDimension", "field": "primaryDimension"},
        {"name": "by_mechanism", "field": "mechanism"},
        {"name": "by_status", "field": "status"},
        {"name": "by_maturityState", "field": "maturityState"}
      ]
    },
    "checkpoints": {
      "key_field": "id",
      "description": "Admitted state and native Agent identity for controlled forks.",
      "required_fields": ["id", "schema", "sourceRevision", "formalSessionFsSnapshot", "readyForControlledFork"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "taskId": {"type": "string", "required": false},
        "sourceRevision": {"type": "string", "required": true},
        "sourceCut": {"type": "string", "required": false},
        "checkpointDigest": {"type": "string", "required": false},
        "nativeAgent": {"type": "string", "required": false},
        "nativeVersion": {"type": "string", "required": false},
        "nativeThreadId": {"type": "string", "required": false},
        "nativeSessionSha256": {"type": "string", "required": false},
        "formalSessionFsSnapshot": {"type": "boolean", "required": true},
        "readyForControlledFork": {"type": "boolean", "required": true},
        "admittedState": {"type": "object", "required": false},
        "evidenceIds": {"type": "array", "required": false}
      },
      "indexes": [
        {"name": "by_sourceRevision", "field": "sourceRevision"},
        {"name": "by_nativeAgent", "field": "nativeAgent"},
        {"name": "by_readyForControlledFork", "field": "readyForControlledFork"}
      ]
    },
    "interventions": {
      "key_field": "id",
      "description": "Controlled single-variable interventions applied to a frozen checkpoint.",
      "required_fields": ["id", "schema", "difficultyId", "checkpointId", "variable", "status"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "difficultyId": {"type": "string", "required": true},
        "checkpointId": {"type": "string", "required": true},
        "variable": {"type": "string", "required": true},
        "controlValue": {"type": "object", "required": false},
        "variantValue": {"type": "object", "required": false},
        "model": {"type": "string", "required": false},
        "agentKind": {"type": "string", "required": false},
        "frozen": {"type": "array", "required": false},
        "status": {"type": "string", "required": true},
        "evidenceIds": {"type": "array", "required": false}
      },
      "indexes": [
        {"name": "by_difficultyId", "field": "difficultyId"},
        {"name": "by_checkpointId", "field": "checkpointId"},
        {"name": "by_variable", "field": "variable"},
        {"name": "by_model", "field": "model"}
      ]
    },
    "crossings": {
      "key_field": "id",
      "description": "Per-arm measured crossing outcomes. Missing gates are omitted, not imputed.",
      "required_fields": ["id", "schema", "interventionId", "arm", "behaviorPass", "scopeDrift"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "interventionId": {"type": "string", "required": true},
        "difficultyId": {"type": "string", "required": false},
        "checkpointId": {"type": "string", "required": false},
        "arm": {"type": "string", "required": true},
        "behaviorPass": {"type": "boolean", "required": true},
        "buildPass": {"type": "boolean", "required": false},
        "scopeDrift": {"type": "boolean", "required": true},
        "timedOut": {"type": "boolean", "required": false},
        "durationMs": {"type": "integer", "required": false},
        "firstMutationMs": {"type": "integer", "required": false},
        "gatewayRequests": {"type": "integer", "required": false},
        "changedPaths": {"type": "array", "required": false},
        "outputSessionSha256": {"type": "string", "required": false},
        "aggregateScoreMilli": {"type": "integer", "required": false},
        "axes": {"type": "object", "required": false},
        "build": {"type": "object", "required": false},
        "infrastructure": {"type": "object", "required": false},
        "evidenceIds": {"type": "array", "required": false}
      },
      "indexes": [
        {"name": "by_interventionId", "field": "interventionId"},
        {"name": "by_difficultyId", "field": "difficultyId"},
        {"name": "by_checkpointId", "field": "checkpointId"},
        {"name": "by_arm", "field": "arm"},
        {"name": "by_behaviorPass", "field": "behaviorPass"},
        {"name": "by_buildPass", "field": "buildPass"}
      ]
    },
    "decisions": {
      "key_field": "id",
      "description": "Evidence-linked Agent decisions after controlled experiments.",
      "required_fields": ["id", "schema", "decision", "reason"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "difficultyId": {"type": "string", "required": false},
        "interventionId": {"type": "string", "required": false},
        "decision": {"type": "string", "required": true},
        "reason": {"type": "text", "required": true},
        "preferredArm": {"type": "string", "required": false},
        "nextExperiment": {"type": "string", "required": false},
        "nextCheckpointBoundary": {"type": "string", "required": false},
        "holdConstant": {"type": "array", "required": false},
        "measure": {"type": "array", "required": false},
        "evidenceIds": {"type": "array", "required": false}
      },
      "indexes": [
        {"name": "by_difficultyId", "field": "difficultyId"},
        {"name": "by_interventionId", "field": "interventionId"},
        {"name": "by_decision", "field": "decision"}
      ]
    },
    "capability_profiles": {
      "key_field": "id",
      "description": "Derived Code Agent capability profiles; raw crossings remain authority.",
      "required_fields": ["id", "schema", "agentKind", "sampleCount"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "agentKind": {"type": "string", "required": true},
        "model": {"type": "string", "required": false},
        "profileRevision": {"type": "string", "required": false},
        "sampleCount": {"type": "integer", "required": true},
        "dimensions": {"type": "object", "required": false},
        "mechanisms": {"type": "object", "required": false},
        "normalization": {"type": "object", "required": false},
        "inputCrossingIds": {"type": "array", "required": false}
      },
      "indexes": [
        {"name": "by_agentKind", "field": "agentKind"},
        {"name": "by_model", "field": "model"}
      ]
    },
    "evidence_refs": {
      "key_field": "id",
      "description": "Immutable content-addressed references to public or retained evidence.",
      "required_fields": ["id", "schema", "kind", "uri"],
      "fields": {
        "id": {"type": "string", "required": true},
        "schema": {"type": "string", "required": true},
        "kind": {"type": "string", "required": true},
        "uri": {"type": "string", "required": true},
        "sha256": {"type": "string", "required": false},
        "byteLength": {"type": "integer", "required": false},
        "sourceRevision": {"type": "string", "required": false},
        "producerRun": {"type": "string", "required": false},
        "public": {"type": "boolean", "required": false},
        "metadata": {"type": "object", "required": false}
      },
      "indexes": [
        {"name": "by_kind", "field": "kind"},
        {"name": "by_sourceRevision", "field": "sourceRevision"},
        {"name": "by_producerRun", "field": "producerRun"}
      ]
    }
  }
}
